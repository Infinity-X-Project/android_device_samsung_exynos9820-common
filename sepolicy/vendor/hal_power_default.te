allow hal_power_default pm_qos_device:chr_file rw_file_perms;

allow hal_power_default sysfs_battery:dir search;
allow hal_power_default sysfs_battery_writable:file rw_file_perms;

# Write the top-app utilization clamp for interaction boosts.
allow hal_power_default cgroup:file rw_file_perms;

hal_client_domain(hal_power_default, hal_thermal)

# ADPF hint sessions set the priority of the threads they manage.
allow hal_power_default self:capability sys_nice;

# Binder callbacks from servicemanager to the HAL service.
binder_use(hal_power_default)
